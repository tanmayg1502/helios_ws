<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mapping_localization_pkg</name>
  <version>0.1.0</version>
  <description>
    Mapping and localization for the Helios A4WD3 mecanum rover. Everything
    that owns map -> odom lives here; sensing and odometry fusion stay in
    perception_pkg. Each approach is a self-contained folder and runs
    independently of the other:

      slam_toolbox/  - 2D LiDAR SLAM (Hokuyo UST-10LX), publishes /map
      rtabmap/       - 3D RGB-D + LiDAR SLAM (GTSAM pose-graph optimization)
      localization/  - AMCL against an already-built map (no mapping)

    Both are fed by the ZED 2i, the Hokuyo, and the EKF-fused odometry from
    perception_pkg's sensor_fusion, which must already be running.
  </description>
  <maintainer email="upadhyp1@uci.edu">pran</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rtabmap/ -->
  <exec_depend>rtabmap_ros</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>
  <!-- slam_toolbox/ -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- localization/ (AMCL against a saved map). Note: nav2_bringup is NOT
       used or required — amcl_localization.launch.py starts map_server,
       amcl and lifecycle_manager itself. -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- Consumes topics from these; expects sensor_fusion/bringup.launch.py
       already running rather than launching them itself. -->
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>urg_node2</exec_depend>
  <exec_depend>sensor_fusion</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
