Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Costmaps1
        - /Plans1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 0.6
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 255; 85; 0
      Color Transformer: FlatColor
    - Class: rviz_common/Group
      Name: Costmaps
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Map
          Enabled: true
          Topic:
            Value: /map
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Color Scheme: map
          Alpha: 0.7
        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Topic:
            Value: /global_costmap/costmap
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Color Scheme: costmap
          Alpha: 0.35
        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Topic:
            Value: /local_costmap/costmap
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Color Scheme: costmap
          Alpha: 0.55
    - Class: rviz_common/Group
      Name: Plans
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: Global Plan
          Enabled: true
          Topic:
            Value: /plan
            Depth: 5
            Durability Policy: Volatile
            Reliability Policy: Reliable
          Color: 0; 255; 0
          Line Width: 0.03
          Line Style: Lines
        - Class: rviz_default_plugins/Path
          Name: Local Plan
          Enabled: true
          Topic:
            Value: /local_plan
            Depth: 5
            Durability Policy: Volatile
            Reliability Policy: Reliable
          Color: 0; 170; 255
          Line Width: 0.03
          Line Style: Lines
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Alpha: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Scale: 90
      Angle: 0
      Target Frame: base_link
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Navigation 2:
    collapsed: false
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: false
